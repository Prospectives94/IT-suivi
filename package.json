{
  "name": "it-ticket-manager-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo configuration for IT Ticket Manager (React Client + Node.js Express Server)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "start:server": "npm run start --workspace=server"
  },
  "onlyBuiltDependencies": [
    "better-sqlite3",
    "esbuild"
  ],
  "overrides": {
    "workbox-build": {
      "glob": "$glob"
    },
    "glob": "10.4.5"
  }
}

